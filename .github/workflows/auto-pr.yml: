name: Auto PR to main

on:
  push:
    branches: [feature]

permissions:
  contents: read
  pull-requests: write

jobs:
  open-pr:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5

      - name: Create PR if none is open
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          EXISTING=$(gh pr list --head feature --base main --state open --json number -q '.[0].number')
          if [ -z "$EXISTING" ]; then
            gh pr create --head feature --base main \
              --title "Merge feature into main" \
              --body "Automatically created from the feature branch."
          else
            echo "PR #$EXISTING already open"
          fi
